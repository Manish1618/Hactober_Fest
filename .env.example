# Copy to .env and fill in. Never commit .env.

# --- Snowflake (application user, read-only role) ---
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=DATAMIND_APP
# Key-pair authentication (preferred). Path to the unencrypted or encrypted PKCS#8 private key.
SNOWFLAKE_PRIVATE_KEY_PATH=./keys/datamind_app_rsa_key.p8
# Only if the private key is encrypted
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=DATAMIND_READER
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=30

# --- Gemma model endpoint ---
# provider: ollama (local or remote Ollama server) or scripted (offline stub, no model)
DATAMIND_MODEL_PROVIDER=ollama
DATAMIND_MODEL_ENDPOINT=http://localhost:11434
DATAMIND_MODEL_NAME=gemma3:12b
DATAMIND_MODEL_TEMPERATURE=0.0
DATAMIND_MODEL_TIMEOUT_SECONDS=60
DATAMIND_MODEL_MAX_TOKENS=1024

# --- App ---
# backend: snowflake (real) or local (offline fixture for development and tests only)
DATAMIND_BACKEND=snowflake
DATAMIND_DATASET=tpch_sf1
DATAMIND_MAX_ROWS=1000
